# Public site URL, used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.akshayenterprise.com

# Resend (https://resend.com). Without a key, form submissions are logged on the server instead of emailed.
RESEND_API_KEY=
# Inbox that receives RFQs and contact messages
RFQ_TO_EMAIL=sales@akshayenterprise.com
# Verified sender on your Resend domain
RFQ_FROM_EMAIL="Akshay Enterprise Website <website@akshayenterprise.com>"
